FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /work

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential=12.12 curl=8.14.1-2+deb13u7 git=1:2.47.3-0+deb13u1 \
    libxml2-dev=2.12.7+dfsg+really2.9.14-2.1+deb13u3 libxslt1-dev=1.1.35-1.2+deb13u3 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 1000 app \
 && chown app:app /work

COPY requirements.txt requirements-dev.txt* ./
RUN pip install --no-cache-dir pip==25.0.1 && \
    if [ -f requirements.txt ]; then pip install --no-cache-dir -r requirements.txt; fi && \
    if [ -f requirements-dev.txt ]; then pip install --no-cache-dir -r requirements-dev.txt; fi

USER app
COPY --chown=app:app . .

# The Kafka consumer uses this same image. Run it with another command:
#   python -m src.events.consumer
# It needs KAFKA_BROKERS, and the same NBA_DATA_DIR and NBA_ART_DIR as the API.
CMD ["uvicorn", "src.service.app:app", "--host", "0.0.0.0", "--port", "5000"]
