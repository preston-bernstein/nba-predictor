# docker-allow: root container user not yet audited for file ownership and ports; add USER after testing
# docker-allow: unpinned image has no pinnable upstream tag or digest (local build or moving tag)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /work

# existing finding; fix when this line is next changed
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl git libxml2-dev libxslt1-dev \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt* ./
# existing finding; fix when this line is next changed
# hadolint ignore=DL3013,DL3042
RUN pip install -U pip && \
    if [ -f requirements.txt ]; then pip install -r requirements.txt; fi && \
    if [ -f requirements-dev.txt ]; then pip install -r requirements-dev.txt; fi

COPY . .

# The Kafka consumer uses this same image. Run it with another command:
#   python -m src.events.consumer
# It needs KAFKA_BROKERS, and the same NBA_DATA_DIR and NBA_ART_DIR as the API.
CMD ["uvicorn", "src.service.app:app", "--host", "0.0.0.0", "--port", "5000"]
